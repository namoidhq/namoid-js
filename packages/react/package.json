{
  "name": "@namoidhq/react",
  "version": "0.1.0",
  "description": "React SDK for NamoID, enterprise identity for India (OAuth 2.1 / OIDC): provider, hooks, and hosted sign-in, sign-up, and waitlist components.",
  "keywords": [
    "namoid",
    "authentication",
    "auth",
    "oauth",
    "oidc",
    "openid-connect",
    "identity",
    "sso",
    "passkeys",
    "mfa",
    "india",
    "dpdp",
    "digilocker",
    "aadhaar",
    "react"
  ],
  "homepage": "https://namoid.in",
  "bugs": {
    "url": "https://github.com/namoidhq/namoid-js/issues",
    "email": "hello@namoid.in"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namoidhq/namoid-js.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "PolyMindsLabs Pvt. Ltd. <hello@namoid.in> (https://namoid.in)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@namoidhq/js": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "typescript": "^6.0.3"
  }
}
