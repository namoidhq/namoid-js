{
  "name": "@namoidhq/js",
  "version": "3.1.0",
  "description": "Core JavaScript SDK for NamoID Hosted Auth using OpenID Connect Authorization Code with PKCE.",
  "keywords": [
    "namoid",
    "authentication",
    "auth",
    "identity",
    "passkeys",
    "mfa",
    "india",
    "dpdp",
    "digilocker",
    "aadhaar"
  ],
  "homepage": "https://namoid.in",
  "bugs": {
    "url": "https://github.com/namoidhq/namoid-js/issues",
    "email": "hello@namoid.in"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namoidhq/namoid-js.git",
    "directory": "packages/js"
  },
  "license": "MIT",
  "author": "PolyMindsLabs Pvt. Ltd. <hello@namoid.in> (https://namoid.in)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
