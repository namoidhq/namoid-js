{
  "name": "namoid-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NamoID JavaScript & TypeScript SDKs monorepo (@namoidhq/js, @namoidhq/react, @namoidhq/nextjs).",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && node --test tests/*.test.mjs packages/react/tests/*.test.mjs",
    "test:browser": "pnpm build && playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jose": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
